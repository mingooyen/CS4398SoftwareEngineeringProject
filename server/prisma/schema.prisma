generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  userPreferences UserPreferences?
  watchlist       WatchlistEntry[]
  watched         WatchedEntry[]
  groupMembers    GroupMember[]
  createdGroups   Group[]           @relation("GroupCreator")
  createdSessions Session[]         @relation("SessionCreator")
  votes           Vote[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserPreferences {
  id             String   @id @default(uuid())
  userId         String   @unique
  favoriteGenres String[] // JSON array stored as text[] or Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchlistEntry {
  id       String   @id @default(uuid())
  userId   String
  tmdbId   Int
  addedAt  DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
}

model WatchedEntry {
  id        String   @id @default(uuid())
  userId    String
  tmdbId    Int
  rating    Decimal? @db.Decimal(3, 1)
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
}

model Group {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator User          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members GroupMember[]
  sessions Session[]

  @@index([slug])
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model Session {
  id           String    @id @default(uuid())
  groupId      String
  scheduledAt  DateTime
  movieTmdbId  Int?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User   @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  votes   Vote[]

  @@index([groupId])
}

model Vote {
  id           String   @id @default(uuid())
  sessionId    String
  userId       String
  movieTmdbId  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}
