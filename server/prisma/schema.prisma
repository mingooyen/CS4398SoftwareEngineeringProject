generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

/// Platform-wide admin: may list all groups, open any group, and patch/delete any group (same as group ADMIN for `/api/v1/groups/:groupId` admin actions). Promote in DB: UPDATE "User" SET "systemRole" = 'SYSTEM_ADMIN' WHERE email = '<admin-email>';
enum UserSystemRole {
  USER
  SYSTEM_ADMIN
}

/// Global catalog movies are stored in `MovieCatalogEntry` (see model docs). SYSTEM_ADMIN may INSERT via API (POST /movies/catalog).
model User {
  id           String         @id @default(uuid())
  /// Human-facing numeric id for search/invite UX. Starts at 1.
  numericId    BigInt         @unique @default(autoincrement()) @db.BigInt
  email        String         @unique
  passwordHash String
  displayName  String
  /// USER: only groups where GroupMember exists. SYSTEM_ADMIN: all groups.
  systemRole   UserSystemRole @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens     RefreshToken[]
  userPreferences   UserPreferences?
  watchlist         WatchlistEntry[]
  watched           WatchedEntry[]
  groupMembers      GroupMember[]
  createdGroups     Group[]             @relation("GroupCreator")
  createdSessions   Session[]           @relation("SessionCreator")
  votes             Vote[]
  catalogMoviesAdded MovieCatalogEntry[]
}

/// Row provenance: TMDB import/sync vs manually added by platform admin (custom poster/title).
enum MovieCatalogSource {
  TMDB
  CUSTOM_ADMIN
}

/// DATABASE ENGINEER — global “overall list” of movies (browse + admin CRUD)
///
/// **Names**
/// - `title` (required): primary display title in the app; index for search.
/// - `originalTitle` (optional): e.g. original language title from TMDB.
/// - Consider `pg_trgm` or full-text on `title` if you need fuzzy search at scale.
///
/// **Posters / photos — where to store and how to resolve a URL**
/// Pick one strategy per row (or combine TMDB path + fallback):
///
/// | Field | Use when | Application resolves image as |
/// |------|----------|--------------------------------|
/// | `posterPath` | Movie comes from TMDB | `https://image.tmdb.org/t/p/w500` + `posterPath` (also try w185/w342 per layout). Set `source = TMDB`, set `tmdbId`. |
/// | `customPosterUrl` | Admin pasted or backend stored a **public HTTPS URL** (CDN, Imgix, etc.) | Use URL as-is; validate origin in API if required. |
/// | `posterStorageKey` | Your object storage (S3, GCS, Azure Blob) | Store **key only** in DB (e.g. `catalog-posters/2026/uuid.jpg`). App uses env `POSTER_CDN_BASE_URL` or signed GET URL; **do not store binary blobs in Postgres**. |
///
/// **Suggested ingest flow (TMDB)**
/// 1) Admin or job searches TMDB → save `tmdbId`, `title`, `originalTitle`, `releaseYear`, `posterPath` from API, `source = TMDB`.
/// 2) Optionally background job refreshes poster/title when TMDB updates (match on `tmdbId`).
///
/// **Suggested ingest flow (custom / upload)**
/// 1) Client uploads file → API writes to object storage → save `posterStorageKey` + `title`, `source = CUSTOM_ADMIN`, `addedByUserId`.
/// 2) Or admin provides image URL → save `customPosterUrl` after SSRF-safe fetch rules.
///
/// **Admin-only writes:** Gate INSERT/UPDATE/DELETE on `User.systemRole = SYSTEM_ADMIN` in the API (see `requireSystemAdmin`). Regular users read catalog for the overall list.
model MovieCatalogEntry {
  id        String   @id @default(uuid())
  /// Primary UI title (always set).
  title     String
  originalTitle String?
  releaseYear   Int?
  /// When set, unique; sync metadata/images from TMDB using this id.
  tmdbId    Int?     @unique
  /// TMDB relative path, e.g. `/abc.jpg` — full URL built with image.tmdb.org + size segment.
  posterPath String?
  /// Full URL when the poster is not from TMDB (admin-linked or external CDN).
  customPosterUrl String?
  /// Object-storage key for uploaded poster binary (no blob in relational DB).
  posterStorageKey String?
  source    MovieCatalogSource @default(TMDB)
  synopsis  String?
  addedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addedBy User? @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@index([title])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserPreferences {
  id             String   @id @default(uuid())
  userId         String   @unique
  favoriteGenres String[] // JSON array stored as text[] or Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchlistEntry {
  id       String   @id @default(uuid())
  userId   String
  tmdbId   Int
  addedAt  DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
}

model WatchedEntry {
  id        String   @id @default(uuid())
  userId    String
  tmdbId    Int
  rating    Decimal? @db.Decimal(3, 1)
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
}

model Group {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator User          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members GroupMember[]
  sessions Session[]

  @@index([slug])
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

/// DATABASE ENGINEER — group invite recommendations (friends + other-group users)
///
/// Recommended persistent design for the Invite Member popup:
/// 1) Friend graph
///    - table: `Friendship`
///    - fields: `id`, `requesterUserId`, `addresseeUserId`, `status` (PENDING|ACCEPTED|BLOCKED),
///      `createdAt`, `updatedAt`
///    - constraints: unique unordered pair (A,B), indexes on requester/addressee/status.
///    - tracking friend IDs list:
///      - for each user, derive `friendUserIds` from ACCEPTED rows where the user is requester or addressee.
///      - return this as `friendIds: string[]` (or numericId[]) in profile/friends APIs.
///      - optional optimization: maintain a materialized/cache table keyed by `userId` with `friendIds` array.
///
/// 2) Group invitations
///    - table: `GroupInvite`
///    - fields: `id`, `groupId`, `inviterUserId`, `inviteeUserId`, `status` (PENDING|ACCEPTED|DECLINED|EXPIRED),
///      `createdAt`, `updatedAt`, `expiresAt?`
///    - constraints: unique pending invite per (groupId, inviteeUserId), indexes on invitee/status and group/status.
///
/// 3) API contract for popup
///    - GET `/api/v1/groups/:groupId/invite-candidates?q=` should return:
///      { candidates: [{ userId, displayName, avatarUrl?, source: 'friend'|'other-group', mutualGroupNames: string[] }] }
///    - ranking suggestion:
///      a) accepted friends first,
///      b) then users from overlapping groups,
///      c) exclude current members and blocked users.
///
/// 4) Add/remove member endpoints (creator/admin-only)
///    - POST `/api/v1/groups/:groupId/invites` (create invite),
///    - POST `/api/v1/groups/:groupId/members/:userId/remove` (remove member),
///    - enforce: only group creator or platform SYSTEM_ADMIN may remove/delete.
///
/// 5) Remove frontend mock data when backend is connected
///    - Delete `MOCK_FRIENDS`, `MOCK_GROUP_INVITES`, and localStorage fallback branches in frontend.
///    - Source the Friends tab entirely from DB-backed endpoints (`/api/v1/users/search`, friendship APIs).

model Session {
  id           String    @id @default(uuid())
  groupId      String
  scheduledAt  DateTime
  movieTmdbId  Int?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User   @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  votes   Vote[]

  @@index([groupId])
}

model Vote {
  id           String   @id @default(uuid())
  sessionId    String
  userId       String
  movieTmdbId  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}
